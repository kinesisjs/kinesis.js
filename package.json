{
  "name": "kinesisjs",
  "version": "0.0.0",
  "private": true,
  "description": "Kinesis.js monorepo — TypeScript-first, framework-agnostic vehicle interpolation engine",
  "license": "MIT",
  "author": "Muzaffer Aşkar",
  "homepage": "https://github.com/kinesisjs/kinesis.js#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kinesisjs/kinesis.js.git"
  },
  "bugs": {
    "url": "https://github.com/kinesisjs/kinesis.js/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" build",
    "dev": "pnpm -r --filter \"./packages/*\" --parallel dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:bench": "vitest bench --run",
    "typecheck": "pnpm -r --filter \"./packages/*\" typecheck",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "pnpm -r exec rimraf dist node_modules coverage",
    "size": "node scripts/check-bundle-sizes.mjs",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm size",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "pnpm build && changeset publish",
    "prepare": "husky"
  },
  "devDependencies": {
    "@angular/common": "^22",
    "@angular/compiler": "^22",
    "@angular/compiler-cli": "^22",
    "@angular/core": "^22",
    "@angular/platform-browser": "^22",
    "@angular/platform-browser-dynamic": "^22",
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.0",
    "@eslint/js": "^10.0.1",
    "@swc/core": "^1.15.43",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.7.0",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17",
    "ng-packagr": "^22",
    "ol": "^10.9.0",
    "prettier": "^3.9.5",
    "rimraf": "^6.0.1",
    "rxjs": "^7.8",
    "tsup": "^8.3.5",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.63.0",
    "vitest": "^4.1.10",
    "zone.js": "^0.16"
  },
  "pnpm": {
    "overrides": {
      "@angular/core": "^22",
      "@angular/common": "^22",
      "@angular/compiler": "^22",
      "@angular/platform-browser": "^22",
      "@angular/platform-browser-dynamic": "^22"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-39pv-4j6c-2g6v",
        "GHSA-48r7-hpm6-gfxm",
        "GHSA-p3vc-36g9-x9gr",
        "GHSA-q6f4-qqrg-jv6x",
        "GHSA-rgjc-h3x7-9mwg"
      ]
    }
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "prettier --write",
      "eslint --max-warnings=0 --no-warn-ignored"
    ],
    "*.{json,md,yml,yaml,scss,css,html}": [
      "prettier --write"
    ]
  }
}
